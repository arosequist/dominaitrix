{
  "manifest_version": 3,
  "name": "DOMinAItrix",
  "version": "0.1.2",
  "description": "Adds curated WebMCP tools to supported websites.",
  "minimum_chrome_version": "135",
  "permissions": [
    "activeTab",
    "alarms",
    "scripting",
    "storage",
    "userScripts"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DOMinAItrix",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "options/options.html"
}
